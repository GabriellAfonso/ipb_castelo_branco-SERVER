# ─── Grafana ─────────────────────────────────────────────────────────────────
# Read only by the grafana service. Keep application secrets out of this file: the
# container is reachable from the internet and needs none of them.
#
# GF_SERVER_ROOT_URL must match the nginx location exactly (/ipbcb/gfd/), and
# GF_SERVER_SERVE_FROM_SUB_PATH must be true — nginx proxies with a variable, so it
# does not strip the prefix and Grafana receives the full path.
GF_SECURITY_ADMIN_USER=change-me
GF_SECURITY_ADMIN_PASSWORD=change-me
GF_SERVER_ROOT_URL=https://your-domain.com/ipbcb/gfd/
GF_SERVER_SERVE_FROM_SUB_PATH=true
